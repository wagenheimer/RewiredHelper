/* =========================================================================
   UnityRewiredHelper - Modern UI Toolkit Stylesheet
   ========================================================================= */

:root {
    --rh-accent: #3388ff;
    --rh-accent-light: #5ca1ff;
    --rh-bg: #222226;
    --rh-card-bg: #2a2a2e;
    --rh-card-header: #323236;
    --rh-border: #3c3c42;
    --rh-text: #e6e6e6;
    --rh-text-dim: #999999;
    --rh-pass: #3ec972;
    --rh-warn: #f5a623;
    --rh-fail: #e84c4c;
    --rh-info: #33bbf5;
}

/* Base Window / Container */
.rh-root {
    flex-grow: 1;
    background-color: var(--rh-bg);
    color: var(--rh-text);
    padding: 10px 14px;
    font-size: 12px;
}

/* Audit rows: the collapsed Details section and the Ping button */
.rh-check-details {
    margin-top: 4px;
}

.rh-check-ping {
    flex-shrink: 0;
    margin-left: 8px;
}

/* Audit summary line colour (state classes toggled from RewiredHelperAuditView) */
.rh-summary-pass { color: var(--rh-pass); }
.rh-summary-warn { color: var(--rh-warn); }
.rh-summary-fail { color: var(--rh-fail); }

/* Full-width column holding header + tabs + content (uses the whole window) */
.rh-page {
    flex-grow: 1;
    width: 100%;
}

/* Header Banner */
.rh-header {
    background-color: var(--rh-card-bg);
    border-bottom-width: 2px;
    border-bottom-color: var(--rh-accent);
    padding: 12px 14px;
    margin-bottom: 10px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.rh-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.rh-header-left {
    flex-direction: row;
    align-items: center;
}

.rh-header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-right: 8px;
}

.rh-header-version {
    background-color: rgba(51, 136, 255, 0.2);
    border-color: var(--rh-accent);
    border-width: 1px;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--rh-accent-light);
}

.rh-header-subtitle {
    font-size: 11px;
    color: var(--rh-text-dim);
    margin-top: 4px;
}

/* Toolbar Buttons */
.rh-toolbar-actions {
    flex-direction: row;
    align-items: center;
}

.rh-toolbar-btn {
    height: 26px;
    font-size: 11px;
    margin-left: 6px;
    padding: 0 10px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* A leading icon gets its own reserved box; inline, a fallback emoji glyph draws wider than it
   measures and the following text would overlap it. */
.rh-btn-icon {
    min-width: 14px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.rh-btn-text {
    flex-shrink: 0;
}

.rh-toolbar-btn-primary {
    background-color: #2e6bc0;
    color: #ffffff;
    -unity-font-style: bold;
}

/* Tab Bar */
.rh-tab-row {
    flex-direction: row;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rh-border);
}

.rh-tab-btn {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 32px;
    font-size: 11px;
    -unity-text-align: middle-center;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: var(--rh-card-bg);
    color: var(--rh-text-dim);
    margin-right: 2px;
}

.rh-tab-btn:hover {
    background-color: #38383e;
    color: #ffffff;
}

.rh-tab-btn.active {
    background-color: #2b3952;
    border-bottom-color: var(--rh-accent);
    color: #ffffff;
    -unity-font-style: bold;
}

/* Card Container */
.rh-card {
    background-color: var(--rh-card-bg);
    border-width: 1px;
    border-color: var(--rh-border);
    border-radius: 6px;
    margin-bottom: 10px;
    padding: 10px 12px;
}

.rh-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rh-border);
}

.rh-card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
}

.rh-card-subtitle {
    font-size: 11px;
    color: var(--rh-text-dim);
    margin-top: 2px;
}

/* Status Badges */
.rh-badge {
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    -unity-font-style: bold;
    align-self: center;
}

.rh-badge-pass {
    background-color: rgba(62, 201, 114, 0.18);
    border-width: 1px;
    border-color: var(--rh-pass);
    color: var(--rh-pass);
}

.rh-badge-warn {
    background-color: rgba(245, 166, 35, 0.18);
    border-width: 1px;
    border-color: var(--rh-warn);
    color: var(--rh-warn);
}

.rh-badge-fail {
    background-color: rgba(232, 76, 76, 0.18);
    border-width: 1px;
    border-color: var(--rh-fail);
    color: var(--rh-fail);
}

.rh-badge-info {
    background-color: rgba(51, 187, 245, 0.18);
    border-width: 1px;
    border-color: var(--rh-info);
    color: var(--rh-info);
}

/* Product Type Badges */
/* Callout Box */
.rh-callout {
    padding: 8px 10px;
    border-radius: 4px;
    margin-top: 6px;
    margin-bottom: 8px;
    border-left-width: 4px;
    font-size: 11px;
}

.rh-callout-info {
    background-color: rgba(51, 136, 255, 0.12);
    border-left-color: var(--rh-accent);
    color: #e0eeff;
}

.rh-callout-warn {
    background-color: rgba(245, 166, 35, 0.12);
    border-left-color: var(--rh-warn);
    color: #fff2d6;
}

.rh-callout-pass {
    background-color: rgba(62, 201, 114, 0.12);
    border-left-color: var(--rh-pass);
    color: #dffff0;
}

/* Code Box */
.rh-code-box {
    background-color: #19191c;
    border-width: 1px;
    border-color: #2f2f36;
    border-radius: 4px;
    padding: 8px 10px;
    margin-top: 4px;
    margin-bottom: 6px;
}

.rh-code-text {
    font-size: 11px;
    color: #8ed684;
}

/* Checklist Item */
.rh-checklist-item {
    background-color: #242428;
    border-width: 1px;
    border-color: #34343a;
    border-radius: 4px;
    padding: 8px 10px;
    margin-bottom: 6px;
    flex-direction: row;
    align-items: center;
}

.rh-checklist-item.checked {
    border-color: rgba(62, 201, 114, 0.4);
    background-color: rgba(62, 201, 114, 0.06);
}

.rh-checklist-text {
    flex-grow: 1;
    margin-left: 8px;
}

.rh-checklist-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
}

.rh-checklist-desc {
    font-size: 10px;
    color: var(--rh-text-dim);
    margin-top: 2px;
}

/* Catalog Card & Chips */
.rh-catalog-card {
    background-color: #19191d;
    border-width: 1px;
    border-color: #2f2f36;
    border-radius: 4px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.rh-store-chip {
    background-color: #121214;
    border-radius: 3px;
    padding: 2px 6px;
    margin-right: 6px;
    margin-bottom: 4px;
    flex-direction: row;
    align-items: center;
}

/* Generic section foldouts (also used by the Dashboard's collapsed sections). */
.rh-section > .unity-foldout__toggle {
    -unity-font-style: bold;
    font-size: 12px;
    margin-left: 0;
    padding-top: 4px;
    padding-bottom: 4px;
}

.rh-section > .unity-foldout__content {
    margin-left: 4px;
    padding-top: 4px;
}

.rh-section-hint {
    font-size: 10px;
    color: var(--rh-text-dim);
    white-space: normal;
    margin-bottom: 6px;
}

/* =========================================================================
   Inspector
   ========================================================================= */
.rh-inspector {
    padding: 4px 2px 14px 2px;
}

.rh-inspector .rh-header {
    padding: 14px 16px;
    margin-bottom: 14px;
    border-radius: 8px;
}

.rh-inspector .rh-header-title {
    font-size: 17px;
}

.rh-inspector .rh-card {
    padding: 10px 14px 12px 14px;
    margin-bottom: 12px;
    border-radius: 8px;
}

/* Foldout sections: roomier header and an accent rail on the content so groups read as grouped. */
.rh-inspector .rh-section > .unity-foldout__toggle {
    -unity-font-style: bold;
    font-size: 13px;
    margin-left: 0;
    padding-top: 7px;
    padding-bottom: 7px;
}

.rh-inspector .rh-section > .unity-foldout__content {
    margin-left: 0;
    padding: 6px 2px 2px 10px;
    border-left-width: 2px;
    border-left-color: rgba(51, 136, 255, 0.35);
}

.rh-inspector .rh-section-hint {
    font-size: 11px;
    color: var(--rh-text-dim);
    white-space: normal;
    margin-bottom: 8px;
}

/* Serialized fields get vertical breathing room instead of hugging each other. */
.rh-inspector .unity-property-field {
    margin-top: 2px;
    margin-bottom: 5px;
}

.rh-inspector .rh-chip-row {
    margin-top: 4px;
}

.rh-inspector .rh-chip {
    padding: 3px 9px;
    border-radius: 12px;
    margin: 0 6px 6px 0;
}

.rh-inspector .rh-check {
    padding: 7px 10px;
    margin-bottom: 5px;
    border-radius: 4px;
}

.rh-inspector .rh-policy-row {
    margin-bottom: 8px;
}

.rh-inspector .rh-policy-name {
    width: 108px;
    font-size: 11px;
}

/* Check rows */
.rh-check {
    flex-direction: row;
    align-items: flex-start;
    padding: 5px 8px;
    margin-bottom: 3px;
    border-left-width: 3px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.03);
}

.rh-check-pass { border-left-color: var(--rh-pass); }
.rh-check-warn { border-left-color: var(--rh-warn); }
.rh-check-fail { border-left-color: var(--rh-fail); }
.rh-check-info { border-left-color: var(--rh-info); }

.rh-check-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.rh-check-title {
    -unity-font-style: bold;
    font-size: 11px;
    white-space: normal;
}

.rh-check-desc {
    font-size: 10px;
    color: var(--rh-text-dim);
    white-space: normal;
    margin-top: 1px;
}

.rh-check-fix {
    flex-shrink: 0;
    height: 22px;
    margin: 0 0 0 8px;
    font-size: 10px;
}

/* Chips (live status, policy) */
.rh-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.rh-chip {
    flex-direction: row;
    border-width: 1px;
    border-color: var(--rh-border);
    border-radius: 10px;
    padding: 2px 8px;
    margin: 0 4px 4px 0;
    background-color: rgba(255, 255, 255, 0.04);
}

.rh-chip-key {
    font-size: 10px;
    color: var(--rh-text-dim);
    margin-right: 4px;
}

.rh-chip-value {
    font-size: 10px;
    -unity-font-style: bold;
}

.rh-chip-on { border-color: var(--rh-pass); }
.rh-chip-off { border-color: var(--rh-border); }
.rh-chip-warn { border-color: var(--rh-warn); }
.rh-chip-active { border-color: var(--rh-accent); background-color: rgba(51, 136, 255, 0.15); }

.rh-policy-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.rh-policy-name {
    width: 96px;
    font-size: 10px;
    color: var(--rh-text-dim);
}

.rh-code-header {
    flex-direction: row;
    justify-content: flex-end;
    margin-bottom: 6px;
}

.rh-code-copy {
    height: 20px;
    font-size: 10px;
    margin: 0;
}
